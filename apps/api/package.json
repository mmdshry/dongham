{
  "name": "@dongham/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env --env-file ../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env --env-file=../../.env dist/index.js",
    "test": "vitest run",
    "migrate": "tsx --env-file .env --env-file ../../.env src/migrate.ts",
    "import-store": "tsx --env-file .env --env-file ../../.env src/import-store.ts",
    "load-sync": "tsx src/load-sync.harness.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.5",
    "jose": "^6.0.10",
    "nanoid": "^5.1.5",
    "mysql2": "^3.14.1",
    "@dongham/ledger": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
