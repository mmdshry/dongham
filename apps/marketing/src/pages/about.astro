---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { Send } from '@lucide/astro';
import { SUPPORT_BLE } from '../lib/site';
---
<Base
  schema="about"
  title="درباره دونگ‌هام | دفتر حساب گروهی فارسی"
  description="دونگ‌هام دفتر حساب گروهی فارسی برای سفر، خانه، خوابگاه و ساختمان است. کیف پول نیست؛ پول با کارت‌به‌کارت جابه‌جا می‌شود."
  crumbs={[{ name: 'درباره', href: '/about/' }]}
>
  <article class="page">
    <img class="page-photo" src="/theme/cover-empty.webp" width="720" height="480" loading="lazy" decoding="async" alt="دفتر حساب گروهی دونگ‌هام روی میز کار" />
    <h1>درباره دونگ‌هام</h1>
    <p>دونگ‌هام را برای گروهی ساختیم که نمی‌خواهند آخر سفر یا ماه روی کاغذ دعوا کنند. اپ سهم را حساب می‌کند؛ پول را جابه‌جا نمی‌کند. کارت‌به‌کارت بین خودتان است.</p>
    <h2>چه کاری می‌کند</h2>
    <p>دوره، عضو، هزینه با تقسیم نابرابر، قرض، تسویه، چت دوره در حالت ابری، و خروجی حساب. فارسی‌اول و راست‌به‌چپ است. آفلاین روی دستگاه کار می‌کند.</p>
    <h2>چه کاری نمی‌کند</h2>
    <p>کیف پول، درگاه پرداخت بین اعضا، یا نگه‌داشتن موجودی شما نیست. اگر رمز دوره را روشن کنید، سرور متن و رسید حساس را رمزشده نگه می‌دارد؛ کلید رمزگشایی عملیاتی دست ما برای خواندن محتوای قفل‌شده نیست.</p>
    <h2>اعتماد و پشتیبانی</h2>
    <p>مسیر نماد اعتماد و ساماندهی جدا از محصول فنی پیگیری می‌شود و هنوز ادعای دریافت نماد نمی‌کنیم. پشتیبانی در بله پاسخ می‌دهد. شرایط استفاده در <a href="/terms/">صفحه شرایط</a> و سیاست داده در <a href="/privacy/">حریم خصوصی</a> است.</p>
    <p class="support">
      <a href={SUPPORT_BLE}><Send size={16} stroke-width={1.8} /> بله پشتیبانی</a>
    </p>
    <Cta ghostHref="/compare/" ghostLabel="مقایسه با ابزارهای دیگر" />
  </article>
</Base>
<style>
  .support a {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
  }
</style>