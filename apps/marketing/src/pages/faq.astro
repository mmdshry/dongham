---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { SUPPORT_BLE } from '../lib/site';

const faq: { q: string; a: string | string[] }[] = [
  {
    q: 'دونگ‌هام کیف پول است؟',
    a: 'خیر. دفتر حساب گروهی است. پول بین افراد با کارت‌به‌کارت جابه‌جا می‌شود؛ اپ فقط سهم و بدهی را نگه می‌دارد.',
  },
  {
    q: 'بدون اینترنت کار می‌کند؟',
    a: 'بله. ثبت دوره و هزینه روی دستگاه انجام می‌شود. بعد از اتصال، در حالت ابری با سرور همگام می‌شود.',
  },
  {
    q: 'در مدال «دوره جدید» چه چیزهایی را تنظیم می‌کنم؟',
    a: [
      'از خانه یا نوار پایین «ساخت دوره جدید» را بزنید. مدال «دوره جدید» هشت تنظیم دارد: عنوان، قالب، بک‌گراند دوره، نوع حساب، گرد کردن تسویه، ارز پایه، اعضا و گزینهٔ عمومی.',
      'تنها فیلد الزامی عنوان است؛ بدون آن دکمهٔ ساخت کاری نمی‌کند. نمونهٔ داخل جعبه «مثل سفر شمال ۱۴۰۵» است. بقیه پیش‌فرض دارند: قالب سفارشی، نوع حساب تقسیم کلاسیک، بدون گرد کردن، ارز تومان، فقط خودتان عضو، دوره خصوصی، بک‌گراند ساده.',
      'بک‌گراند از پیش‌تنظیم‌های ساده، خانه، سفر، کار، خانواده، خوابگاه، زیارت، جشن، ساختمان و ورزش انتخاب می‌شود یا با «از دستگاه» عکس خودتان. با عوض کردن قالب، بک‌گراند هماهنگ می‌شود مگر قبلاً عکس سفارشی گذاشته باشید. پیش‌تنظیم ورزش قالب جدا ندارد.',
      'با «ساخت»، دوره روی دستگاه ساخته می‌شود، پیام «دوره ساخته شد» می‌آید و وارد همان دوره می‌شوید. شناسه شبیه XXX-XXX است. نوع تقسیم هر هزینه (مساوی، ضریب، مبلغ ثابت، درصد) در این مدال نیست؛ روی خود هزینه انتخاب می‌شود.',
    ],
  },
  {
    q: 'قالب دوره چیست و هر قالب چه کاری می‌کند؟',
    a: [
      'قالب میان‌بر است: تگ پیشنهادی هزینه، گاهی بک‌گراند، و گاهی قانون تکراری یا تنظیم پیش‌فرض را بعد از ساخت می‌گذارد. خود قالب را بعداً عوض نمی‌کنید؛ اثرش همان چیزهایی است که داخل دوره می‌بینید.',
      'سفر دوستانه تگ غذا، حمل‌ونقل، اقامت و بلیت می‌دهد. خانواده تگ هدیه، مهمانی و خرید. خوابگاه / دانشگاه تگ ناهار، اسنپ، قبض اتاق و شارژ. جشن / عروسی تگ سالن، سفره، هدیه و لباس. سفارشی هیچ تگ یا قانونی اضافه نمی‌کند.',
      'هم‌خانگی علاوه بر تگ قبض و اجاره، شش هزینهٔ تکراری با مبلغ صفر می‌سازد: آب و برق و گاز هر دو ماه شمسی؛ اینترنت، شارژ ساختمان و اجاره هر ماه شمسی. مثال: سه هم‌خانه دوره می‌سازند؛ در «هزینه تکراری» شش ردیف خالی می‌آید. مبلغ اجاره را می‌نویسید و اجرا می‌زنید. کسی که بعداً به دوره اضافه شود خودکار داخل همان قوانین نیست.',
      'ناهار محل کار تگ ناهار، اسنپ و قهوه می‌دهد و نوبت ناهار را روی سازنده می‌گذارد تا در تب بیشتر بچرخانید. این قالب خودش گنجه‌بان را روشن نمی‌کند؛ اگر یک نفر همیشه کارت می‌کشد، نوع حساب را جدا روی «گنجه‌بان (یک نفر می‌دهد)» بگذارید.',
      'سفر زیارتی نوع حساب را صندوق مشترک و ارز را تومان می‌کند؛ تگ اتوبوس، اقامت، غذا و نذر هم می‌آید. قبل از ساخت هنوز می‌توانید نوع حساب یا ارز را عوض کنید.',
      'شارژ ساختمان تگ شارژ، آسانسور، پارکینگ و تعمیرات می‌دهد و یک قانون «شارژ ماهانه» با مبلغ صفر می‌سازد. بعداً برای هر عضو «واحد» می‌گذارید و مبلغ شارژ را در تنظیم دوره می‌نویسید تا به قوانین شارژ کپی شود.',
    ],
  },
  {
    q: 'نوع حساب چیست؟ تقسیم کلاسیک، گنجه‌بان و صندوق مشترک چه فرقی دارند؟',
    a: [
      'نوع حساب مدل تسویهٔ کل دوره است، نه نوع تقسیم یک هزینه. بعد از ساخت در اپ عوض نمی‌شود؛ از اول درست انتخاب کنید.',
      'تقسیم کلاسیک پیش‌فرض است. هر کس می‌تواند بپردازد و سهم هر کس جدا حساب می‌شود. مثال: علی، سارا و نیما سفرند. علی رستوران را ۲۰۰ هزار تومان می‌دهد (مساوی بین سه نفر)، سارا تاکسی را ۶۰ هزار. مانده می‌گوید چه کسی به چه کسی بدهکار است؛ لازم نیست یک نفر همه را بدهد.',
      'گنجه‌بان (یک نفر می‌دهد) برای وقتی است که معمولاً یک نفر پرداخت می‌کند و بقیه با او تسویه می‌کنند. گنجه‌بان همان سازندهٔ دوره است. هزینهٔ جدید پیش‌فرض پرداخت‌کننده را او می‌گذارد، ولی روی همان هزینه می‌توانید عوضش کنید. مثال: ناهار اداره؛ مریم همیشه کارت می‌کشد، بقیه فقط سهمشان را به مریم می‌دهند.',
      'صندوق مشترک یک عضو مجازی به نام صندوق می‌سازد. صندوق در شمار افراد تقسیم مساوی نمی‌آید، اما می‌تواند پرداخت‌کننده باشد. در تب حساب «واریز به صندوق» هست. مثال: زیارت؛ هر کس پول نقد به صندوق می‌ریزد، بلیت اتوبوس را از صندوق می‌پردازید، مانده نسبت به صندوق است نه بدهی پراکنده بین زائرها.',
    ],
  },
  {
    q: 'گرد کردن تسویه یعنی چه؟ هزار تومان و ده‌هزار تومان چه می‌کنند؟',
    a: [
      'گرد کردن فقط روی پیشنهاد پرداخت در تب حساب، گزارش و خروجی اعمال می‌شود تا کارت‌به‌کارت با مبلغ گرد راحت‌تر باشد. مبلغ خود هزینه‌ها و ماندهٔ دقیق در «حساب اعضا» گرد نمی‌شود؛ اختلاف در پیشنهاد تسویه می‌ماند.',
      'سه حالت هست: بدون گرد کردن (پیش‌فرض)، هزار تومان، ده‌هزار تومان. مثال با تومان: علی باید به سارا ۱۰٬۴۰۰ بدهد. بدون گرد کردن همان ۱۰٬۴۰۰ پیشنهاد می‌شود. با هزار تومان پیشنهاد ۱۰٬۰۰۰ است؛ اگر مانده ۱۰٬۵۰۰ باشد پیشنهاد ۱۱٬۰۰۰ می‌شود. با ده‌هزار تومان، ماندهٔ ۴۷٬۲۰۰ پیشنهاد ۵۰٬۰۰۰ می‌شود.',
      'اگر چند پرداخت پیشنهادی باشد، باقی‌ماندهٔ گرد کردن روی بزرگ‌ترین مبلغ می‌نشیند تا جمع نزدیک ماندهٔ واقعی بماند.',
      'اگر ارز پایه تومان نباشد، همان پلهٔ ۱۰۰۰ و ۱۰۰۰۰ روی واحد همان ارز است؛ مثلاً در دورهٔ دلار گزینه شبیه «۱٬۰۰۰ دلار آمریکا» است و معمولاً درشت است. برای ارز خارجی معمولاً بدون گرد کردن بگذارید. این تنظیم هم بعد از ساخت در اپ عوض نمی‌شود.',
    ],
  },
  {
    q: 'ارز پایه دوره چه کار می‌کند؟',
    a: [
      'ارز پایه واحد دفتر همان دوره است؛ پیش‌فرض تومان. هزینهٔ جدید و قوانین تکراری همین ارز را می‌گیرند. اگر هزینه‌ای به ارز دیگر ثبت کنید، برای مانده با نرخ آزاد به ارز پایه تبدیل می‌شود.',
      'تومان و ریال نرخ زنده نمی‌خواهند؛ ضریب ثابت ۱۰ است (۱۰ ریال = ۱ تومان). بقیهٔ ارزها از فهرست جستجو می‌شوند و اگر نرخ باشد، معادل تومان را در همان فهرست می‌بینید.',
      'مثال: دورهٔ سفر شمال با تومان. ناهار تهران ۲۰۰ هزار تومان، قهوه استانبول ۱۰ یورو. مانده همه به تومان جمع می‌شود. قالب سفر زیارتی ارز را تومان می‌کند؛ قبل از ساخت می‌توانید عوض کنید.',
    ],
  },
  {
    q: 'اعضا و گزینهٔ «عمومی» در ساخت دوره چیست؟',
    a: [
      'سازنده همیشه مالک دوره است و از تیک اعضا کنار گذاشته می‌شود. بقیه را از دوستان و نام‌های دوره‌های قبلی تیک می‌زنید، یا در «نام جدید» می‌نویسید و «افزودن به لیست» می‌زنید. نام نباید ویرگول داشته باشد. اگر کسی را انتخاب نکنید دوره فقط خودتان را دارد؛ بعداً هم می‌شود عضو اضافه کرد.',
      'عضوی که فقط نام دارد و موبایل یا ایمیل ندارد «فقط محلی — بدون دسترسی ابری» است تا با لینک دعوت وصل شود. اگر نام نمایشی خودتان خالی باشد، صندلی مالک «کاربر» نام می‌گیرد.',
      'گزینهٔ «عمومی (با شناسه قابل مشاهده)» پیش‌فرض خاموش است (خصوصی). اگر روشن باشد هر کس شناسهٔ دوره مثل Ab3-k9Z را بداند می‌تواند حساب و هزینه‌ها را به‌عنوان بیننده ببیند، ولی هزینه یا چت ثبت نمی‌کند. این فهرست جستجوی عمومی نیست؛ فقط یعنی شناسه مثل لینک خواندنی عمل می‌کند. برای نوشتن باید عضو شوید.',
    ],
  },
  {
    q: 'چطور بقیه را دعوت کنم؟',
    a: 'لینک دعوت یا QR بفرستید. برای کار همزمان ابری باید وارد شوید. در حالت آفلاین می‌توانید اعضا را فقط با نام نگه دارید.',
  },
  {
    q: 'تقسیم نابرابر چگونه است؟',
    a: 'مساوی، ضریب، مبلغ ثابت یا درصد. چند پرداخت‌کننده، حق سرویس و انعام جدا پشتیبانی می‌شود.',
  },
  {
    q: 'تسویه کارت‌به‌کارت چیست؟',
    a: 'اپ تصویر کارت می‌سازد، بانک را از BIN یا شبا حدس می‌زند و می‌توانید چند کارت داشته باشید. بدهکار فیش می‌گذارد و طلبکار یا مالک تأیید می‌کند.',
  },
  {
    q: 'رمز دوره چه می‌کند؟',
    a: 'اگر روشن باشد، یادداشت، رسید، پیوست، چت و کارت یا شبا روی سرور با AES-256-GCM ذخیره می‌شوند. کارت و شبا روی دستگاه همیشه AES-GCM هستند.',
  },
  {
    q: 'چطور حساب را حذف کنم؟',
    a: 'از داخل اپ مسیر حساب کاربری، حذف حساب. پشتیبانی بله هم درخواست حذف را می‌گیرد.',
  },
  {
    q: 'آیا باید اپ فروشگاه را نصب کنم؟',
    a: 'وب‌اپ در مرورگر و به‌صورت PWA کار می‌کند. نصب اندروید جدا از این سایت است و برای ایندکس جستجو لازم نیست.',
  },
];
---
<Base
  schema="faq"
  title="سوالات متداول تقسیم هزینه گروهی | دونگ‌هام"
  description="پاسخ به ساخت دوره جدید، قالب، نوع حساب، گرد کردن تسویه، ارز پایه، دعوت QR، تقسیم نابرابر، تسویه کارت‌به‌کارت، رمز دوره و حذف حساب."
  faq={faq}
  crumbs={[{ name: 'سوالات متداول', href: '/faq/' }]}
>
  <article class="page">
    <h1>سوالات متداول دونگ‌هام</h1>
    <p>اگر موضوع در این فهرست نیست، <a href="/guide/">راهنما</a> یا <a href={SUPPORT_BLE}>بله پشتیبانی</a> را ببینید.</p>
    <div class="faq">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          {(Array.isArray(item.a) ? item.a : [item.a]).map((p) => (
            <p>{p}</p>
          ))}
        </details>
      ))}
    </div>
    <Cta ghostHref="/compare/" ghostLabel="مقایسه ابزارها" />
  </article>
</Base>
