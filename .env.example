# API
PORT=8787
HOST=0.0.0.0
# NODE_ENV=development
# MariaDB / MySQL (XAMPP / local mysqld). Tests use MYSQL_TEST_DATABASE or dongham_test.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dongham
# MYSQL_TEST_DATABASE=dongham_test
JWT_SECRET=change-me-in-production
# AES-256-GCM for encrypted period fields (note, receipts, chat, cards). Falls back to JWT_SECRET.
# ENCRYPTION_KEY=
# Leave unset to auto-select: senator if SENATOR_API_KEY is set, else kavenegar if KAVENEGAR_API_KEY is set, else mock.
# OTP_PROVIDER=senator|kavenegar|mock
SENATOR_SMS_URL=https://api.fast-creat.ir/sms
SENATOR_API_KEY=
SENATOR_TEMPLATE=6436172580
SENATOR_TYPE=private
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Local: http://localhost:5173  Production: https://dongham.ir (PWA home is /app)
APP_PUBLIC_URL=http://localhost:5173

# Admin panel (OTP allowlist for admin.dongham.ir)
ADMIN_PHONES=09190755375,09306057083

# Transactional email (SMTP SSL on 465). Password only in local .env — never commit it.
SMTP_HOST=mail.dongham.ir
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=noreply@dongham.ir
SMTP_PASS=
SMTP_FROM=دونگ‌هام <noreply@dongham.ir>

# Google Sign-In (same client ID on API and Vite)
# GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=

# Billing (Zarinpal)
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=1
# ZARINPAL_MONTHLY_RIAL=490000
# ZARINPAL_YEARLY_RIAL=3900000

# Card → Sheba (server only; never put these in the Vite app)
# DRAPI_USERNAME=
# DRAPI_PASSWORD=
# DRAPI_TOKEN_URL=https://drapi.ir/auth/http/token
# DRAPI_CARD_URL=https://drapi.ir/rest/api/main/convertCardToSheba/v1.0/convertcardtosheba

# FX
# FX_PROVIDER_URL=
# NAVASAN_API_KEY=

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
# Without these keys, inbox notifications still work; OS push is off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@dongham.ir

# E2E (Playwright): reuse an already-running mock-OTP API/app instead of starting them; pick a browser channel.
# E2E_REUSE_SERVER=1
# E2E_BROWSER_CHANNEL=chrome

# App / admin: Vite only reads apps/app/.env and apps/admin/.env (not this root file unless copied).
# Leave VITE_API_URL unset so the web clients use same-origin /api (Vite proxy in dev, Apache in prod).
# VITE_API_URL=
VITE_SUPPORT_BALE=https://ble.ir/dongham
# VITE_SUPPORT_WHATSAPP=https://wa.me/98912xxxxxxx
